# Backend Environment Configuration (Example)
# Copy this file to .env and fill in real values.
# Do not commit real keys or secrets to version control.

# Supabase Project Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Google Gemini AI API Configuration (Server-side only)
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Centralized College Google Drive Configuration (Server-side only)
# Modes: "service_account" (preferred with Google Workspace Shared Drive) or "oauth_user"
GOOGLE_DRIVE_MODE=service_account
GOOGLE_DRIVE_SHARED_DRIVE_ID=your-college-shared-drive-id-placeholder
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-college-study-docs-folder-id-placeholder
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json
GOOGLE_DRIVE_OAUTH_TOKEN_PATH=secrets/drive-token.json
# MongoDB Atlas Vector Search
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=student_companion
MONGODB_VECTOR_COLLECTION=study_chunks
MONGODB_VECTOR_INDEX=vector_index

# Vector Embedding Configuration
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# n8n AI Agent Workflow Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/student-chat
N8N_AUTH_HEADER_NAME=X-N8N-WEBHOOK-SECRET
N8N_WEBHOOK_SECRET=your-random-long-n8n-webhook-secret
INTERNAL_API_KEY=your-secure-internal-api-key-for-fastapi
